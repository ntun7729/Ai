{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-website-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-16",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "vars": {
    "AI_BASE_URL": "https://integrate.api.nvidia.com/v1",
    "AI_MODEL": "z-ai/glm-5.1",
    "PROXY_HOSTS": "",
    "PROXY_FAIL_COOLDOWN_MS": "120000",
    "ENABLE_LOGS": "false"
  }
}
